# CLU Environment Configuration
# Copy this to .env and customize for your setup

# Logging level (debug, info, warn, error)
RUST_LOG=info

# Ollama configuration
OLLAMA_HOST=http://ollama:11434

# Docker resource limits (uncomment to override docker-compose.yml)
# COMPOSE_RESOURCE_LIMIT_CPU=2
# COMPOSE_RESOURCE_LIMIT_MEMORY=4g

# Webhook notifications (optional)
# WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Poll interval for feed monitoring
POLL_INTERVAL=30s

# PyPI feed URL
PYPI_FEED_URL=https://pypi.org/rss/packages.xml
